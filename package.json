{
  "name": "@peter.naydenov/visual-controller-for-preact",
  "version": "2.0.0",
  "description": "Visual Controller for Preact - Control multiple Preact apps with a single controller",
  "type": "module",
  "main": "./dist/visual-controller-for-preact.cjs",
  "module": "./dist/visual-controller-for-preact.esm.mjs",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/visual-controller-for-preact.esm.mjs",
      "require": "./dist/visual-controller-for-preact.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "types": "tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "cover": "vitest run --coverage"
  },
  "keywords": [
    "preact",
    "visual-controller",
    "micro-frontend",
    "mfe"
  ],
  "author": "Peter Naydenov",
  "license": "MIT",
  "dependencies": {
    "ask-for-promise": "^3.2.0"
  },
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
